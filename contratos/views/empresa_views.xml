<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_contratos_empresa_form" model="ir.ui.view">
        <field name="name">contratos.empresa.form</field>
        <field name="model">contratos.empresa</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1>
                            <field name="name" placeholder="Nombre de la empresa"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="company_id"
                                   options="{'no_quick_create': True, 'no_create_edit': True}"/>
                            <field name="nit"/>
                            <field name="unidad"/>
                            <field name="organismo_id"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_contratos_empresa_tree" model="ir.ui.view">
        <field name="name">contratos.empresa.tree</field>
        <field name="model">contratos.empresa</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
                <field name="nit"/>
                <field name="unidad"/>
                <field name="organismo_id"/>
            </tree>
        </field>
    </record>

    <record id="action_contratos_empresa" model="ir.actions.act_window">
        <field name="name">Empresas</field>
        <field name="res_model">contratos.empresa</field>
        <field name="view_mode">tree,form</field>
    </record>

</odoo>
