<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_contrato_especifico_facturar_todo_wizard_form" model="ir.ui.view">
        <field name="name">contrato.especifico.facturar.todo.wizard.form</field>
        <field name="model">contrato.especifico.facturar.todo.wizard</field>
        <field name="arch" type="xml">
            <form string="Facturar Todo">
                <group>
                    <field name="contrato_id" invisible="1"/>
                    <field name="departamento_id" required="1" options="{'no_create': True}"/>
                </group>
                <footer>
                    <button string="Confirmar"
                            name="action_confirm"
                            type="object"
                            class="btn-primary"/>
                    <button string="Cancelar" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
