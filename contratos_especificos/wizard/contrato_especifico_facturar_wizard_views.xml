<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_contrato_especifico_facturar_wizard_form" model="ir.ui.view">
        <field name="name">contrato.especifico.facturar.wizard.form</field>
        <field name="model">contrato.especifico.facturar.wizard</field>
        <field name="arch" type="xml">
            <form string="Facturar Línea de Servicio">
                <group string="Línea de Servicio">
                    <field name="line_id" invisible="1"/>
                    <field name="ueb_line_id" invisible="1"/>
                    <field name="product_id" string="Producto/Servicio" readonly="1"/>
                    <field name="line_name" string="Descripción" readonly="1"/>
                </group>
                <group string="Valores a Facturar">
                    <group>
                        <label for="quantity" string="Cantidad"/>
                        <div class="o_field_widget">
                            <field name="quantity" class="o_field_number" options="{'type': 'number'}"/>
                            <span class="ms-2 text-muted">/ <field name="max_quantity" readonly="1" nolabel="1"/></span>
                            <button name="action_set_max_quantity" type="object"
                                    string="Máx" class="btn btn-sm btn-secondary ms-2"/>
                        </div>
                        <label for="price_unit" string="Precio Unitario"/>
                        <div class="o_field_widget">
                            <field name="price_unit" class="o_field_number" options="{'type': 'number'}"/>
                            <span class="ms-2 text-muted">/ <field name="max_price" readonly="1" nolabel="1"/></span>
                            <button name="action_set_max_price" type="object"
                                    string="Máx" class="btn btn-sm btn-secondary ms-2"/>
                        </div>
                    </group>
                </group>
                <footer>
                    <button string="Confirmar"
                            name="action_confirm"
                            type="object"
                            class="btn-primary"/>
                    <button string="Cancelar" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
