<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ═══════════════════════════════════════════════════════════════
         FORM VIEW
    ═══════════════════════════════════════════════════════════════ -->
    <record id="view_contrato_especifico_suplemento_form" model="ir.ui.view">
        <field name="name">contrato.especifico.suplemento.form</field>
        <field name="model">contrato.especifico.suplemento</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_generate_content"
                            string="Generar Contenido"
                            type="object"
                            class="oe_highlight"/>
                    <button name="action_open_contrato_original"
                            string="Ver Contrato Original"
                            type="object"/>
                </header>
                <sheet>
                    <!-- Título -->
                    <div class="oe_title">
                        <label for="name" string="Suplemento"/>
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                        <label for="contrato_id" string="Contrato Específico"/>
                        <h2>
                            <field name="contrato_id" readonly="1"
                                   options="{'no_open': False}"/>
                        </h2>
                    </div>

                    <!-- Metadatos de versión -->
                    <group string="Información del Suplemento">
                        <group>
                            <field name="modified_by_id" string="Creado por" readonly="1"/>
                            <field name="modification_date" string="Fecha de Creación" readonly="1"/>
                        </group>
                        <group>
                            <field name="modificaciones"
                                   string="Modificaciones"
                                   colspan="2"
                                   widget="text"/>
                        </group>
                    </group>

                    <group>
                        <group string="Información General">
                            <field name="marco_id" readonly="1"
                                   options="{'no_open': False}"/>
                            <field name="suplemento_marco_id"
                                   string="Suplemento del Marco"
                                   readonly="1"
                                   options="{'no_open': False}"/>
                            <field name="company_id" readonly="1"/>
                            <field name="partner_id" readonly="1"/>
                            <field name="template_id"
                                   string="Tipo de Contrato"
                                   options="{'no_create': True}"/>
                        </group>
                        <group name="dates" string="Fechas">
                            <field name="date" string="Fecha de Suscripción"/>
                            <field name="start_date"
                                   string="Fecha de Entrada en Vigor"/>
                            <field name="validity_years"
                                   string="Vigencia (años)"/>
                            <field name="end_date" string="Fecha de Finalización"
                                   readonly="1"/>
                        </group>
                    </group>
                    <group>
                        <group string="Representación">
                            <field name="our_representative_id"
                                   string="Nuestro Representante"
                                   readonly="1"/>
                            <field name="our_rep_decision_number"
                                   string="Acuerdo/Resolución"
                                   readonly="1"/>
                            <field name="our_rep_decision_date"
                                   string="Fecha de Resolución"
                                   readonly="1"/>
                            <field name="our_project_leader_id"/>
                            <field name="project_leader_id"
                                   string="Líder del Proyecto del Cliente"
                                   options="{'no_create': True}"/>
                            <field name="application_name"
                                   string="Nombre de la Aplicación"
                                   invisible="not template_type_requires_application_name"/>
                            <field name="template_type_requires_rep" invisible="1"/>
                            <field name="template_type_requires_application_name"
                                   invisible="1"/>
                        </group>
                    </group>
                    <group>
                        <group string="Datos de Facturación">
                            <field name="forma_pago_id"
                                   options="{'no_create': True}"/>
                            <field name="realizada_por_id"
                                   options="{'no_create': True}"/>
                            <field name="transportado_por_id"
                                   options="{'no_create': True}"/>
                            <field name="recibido_por_id"
                                   options="{'no_create': True}"/>
                            <field name="entregada_por_id"
                                   options="{'no_create': True}"/>
                            <field name="contabilizada_por_id"
                                   options="{'no_create': True}"/>
                        </group>
                    </group>

                    <notebook>
                        <page string="Líneas de Servicios" name="service_lines">
                            <field name="line_ids">
                                <tree editable="bottom">
                                    <field name="original_invoiced" invisible="1"/>
                                    <field name="product_id"
                                           string="Producto/Servicio"/>
                                    <field name="name" string="Descripción"/>
                                    <field name="start_date" optional="show"/>
                                    <field name="end_date" optional="show"/>
                                    <field name="quantity" string="Cant." readonly="original_invoiced"/>
                                    <field name="uom_id" string="UdM"/>
                                    <field name="price_unit" string="Precio Unitario" readonly="original_invoiced"/>
                                    <field name="price_subtotal" string="Subtotal"/>
                                    <field name="date_deadline_invoice"
                                           string="Límite Facturación"/>
                                </tree>
                            </field>
                        </page>
                        <page string="Líneas de Servicio por UEB" name="ueb_sections">
                            <field name="ueb_section_ids"
                                   create="0"
                                   delete="0">
                                <tree create="0" decoration-muted="total_amount == 0">
                                    <field name="ueb_id" string="UEB"/>
                                    <field name="total_amount" string="Total"
                                           widget="monetary"/>
                                </tree>
                                <form>
                                    <sheet>
                                        <div class="oe_title">
                                            <h2>
                                                <field name="ueb_id" readonly="1"/>
                                            </h2>
                                        </div>
                                        <field name="line_ids">
                                            <tree editable="bottom">
                                                <field name="original_invoiced" invisible="1"/>
                                                <field name="product_id"
                                                       string="Producto/Servicio"/>
                                                <field name="name"
                                                       string="Descripción"/>
                                                <field name="quantity" string="Cant." readonly="original_invoiced"/>
                                                <field name="uom_id" string="UdM"/>
                                                <field name="price_unit"
                                                       string="Precio Unitario" readonly="original_invoiced"/>
                                                <field name="price_subtotal"
                                                       string="Subtotal"/>
                                            </tree>
                                        </field>
                                    </sheet>
                                </form>
                            </field>
                        </page>
                        <page string="Contenido del Contrato" name="content">
                            <div style="max-width: 800px; margin: 0 auto; border: 1px solid #dee2e6; padding: 40px; background: white; min-height: 1000px; overflow-wrap: break-word; font-family: 'Times New Roman', Times, serif;">
                                <field name="content"
                                       widget="html"
                                       options="{'style-inline': true}"/>
                            </div>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- ═══════════════════════════════════════════════════════════════
         LIST VIEW
    ═══════════════════════════════════════════════════════════════ -->
    <record id="view_contrato_especifico_suplemento_tree" model="ir.ui.view">
        <field name="name">contrato.especifico.suplemento.tree</field>
        <field name="model">contrato.especifico.suplemento</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name" string="Suplemento"/>
                <field name="contrato_id" string="Contrato Específico"/>
                <field name="partner_id" string="Cliente"/>
                <field name="modified_by_id" string="Creado por"/>
                <field name="modification_date" string="Fecha"/>
                <field name="modificaciones" string="Modificaciones" optional="show"/>
            </tree>
        </field>
    </record>

    <!-- ═══════════════════════════════════════════════════════════════
         SEARCH VIEW
    ═══════════════════════════════════════════════════════════════ -->
    <record id="view_contrato_especifico_suplemento_search" model="ir.ui.view">
        <field name="name">contrato.especifico.suplemento.search</field>
        <field name="model">contrato.especifico.suplemento</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="contrato_id"/>
                <field name="partner_id"/>
                <group expand="0" string="Agrupar por">
                    <filter string="Contrato" name="group_contrato"
                            context="{'group_by': 'contrato_id'}"/>
                    <filter string="Cliente" name="group_partner"
                            context="{'group_by': 'partner_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- ═══════════════════════════════════════════════════════════════
         ACTION
    ═══════════════════════════════════════════════════════════════ -->
    <record id="action_contrato_especifico_suplemento" model="ir.actions.act_window">
        <field name="name">Suplementos de Contratos Específicos</field>
        <field name="res_model">contrato.especifico.suplemento</field>
        <field name="view_mode">tree,form</field>
        <field name="search_view_id" ref="view_contrato_especifico_suplemento_search"/>
    </record>

    <menuitem id="menu_contrato_especifico_suplemento"
              name="Suplementos de Contratos Específicos"
              parent="contratos.menu_suplementos_group"
              action="action_contrato_especifico_suplemento"
              sequence="20"/>

</odoo>
