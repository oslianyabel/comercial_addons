<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ═══════════════════════════════════════════════════════════════
         REPORTE: Contrato Específico
    ═══════════════════════════════════════════════════════════════ -->
    <record id="action_report_contrato_especifico" model="ir.actions.report">
        <field name="name">Imprimir Contrato Específico</field>
        <field name="model">contrato.especifico</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">contratos_especificos.report_contrato_especifico_template</field>
        <field name="report_file">contratos_especificos.report_contrato_especifico_template</field>
        <field name="print_report_name">'Contrato Específico - %s' % (object.name)</field>
        <field name="binding_model_id" ref="model_contrato_especifico"/>
        <field name="binding_type">report</field>
    </record>

    <template id="report_contrato_especifico_template">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="web.external_layout">
                    <div class="page">
                        <div style="text-align: justify; font-size: 12px;">
                            <t t-out="o.content"/>
                        </div>
                    </div>
                </t>
            </t>
        </t>
    </template>

    <!-- ═══════════════════════════════════════════════════════════════
         REPORTE: Suplemento de Contrato Específico
    ═══════════════════════════════════════════════════════════════ -->
    <record id="action_report_contrato_especifico_suplemento" model="ir.actions.report">
        <field name="name">Imprimir Suplemento</field>
        <field name="model">contrato.especifico.suplemento</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">contratos_especificos.report_contrato_especifico_suplemento_template</field>
        <field name="report_file">contratos_especificos.report_contrato_especifico_suplemento_template</field>
        <field name="print_report_name">'%s' % (object.name)</field>
        <field name="binding_model_id" ref="model_contrato_especifico_suplemento"/>
        <field name="binding_type">report</field>
    </record>

    <template id="report_contrato_especifico_suplemento_template">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="web.external_layout">
                    <div class="page">
                        <!-- Contenido del contrato -->
                        <div style="text-align: justify; font-size: 12px;">
                            <t t-out="o.content"/>
                        </div>

                        <!-- Líneas de Servicio -->
                        <t t-if="o.line_ids">
                            <div style="margin-top: 24px;">
                                <h4 style="font-size: 12px; margin-bottom: 6px;">Líneas de Servicio</h4>
                                <table style="width:100%; border-collapse: collapse; font-size: 11px;">
                                    <thead>
                                        <tr style="background-color: #f0f0f0;">
                                            <th style="border: 1px solid #ccc; padding: 4px; text-align: left;">Descripción</th>
                                            <th style="border: 1px solid #ccc; padding: 4px; text-align: center;">Cantidad</th>
                                            <th style="border: 1px solid #ccc; padding: 4px; text-align: center;">U.M.</th>
                                            <th style="border: 1px solid #ccc; padding: 4px; text-align: right;">Precio Unit. (CUP)</th>
                                            <th style="border: 1px solid #ccc; padding: 4px; text-align: right;">Subtotal (CUP)</th>
                                            <th style="border: 1px solid #ccc; padding: 4px; text-align: center;">Fecha Inicio</th>
                                            <th style="border: 1px solid #ccc; padding: 4px; text-align: center;">Fecha Final</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <t t-foreach="o.line_ids" t-as="line">
                                            <tr>
                                                <td style="border: 1px solid #ccc; padding: 4px;"><t t-out="line.name"/></td>
                                                <td style="border: 1px solid #ccc; padding: 4px; text-align: center;"><t t-out="line.quantity"/></td>
                                                <td style="border: 1px solid #ccc; padding: 4px; text-align: center;"><t t-out="line.uom_id.name or ''"/></td>
                                                <td style="border: 1px solid #ccc; padding: 4px; text-align: right;"><t t-out="'%.2f' % line.price_unit"/></td>
                                                <td style="border: 1px solid #ccc; padding: 4px; text-align: right;"><t t-out="'%.2f' % line.price_subtotal"/></td>
                                                <td style="border: 1px solid #ccc; padding: 4px; text-align: center;"><t t-out="line.start_date and line.start_date.strftime('%d/%m/%Y') or ''"/></td>
                                                <td style="border: 1px solid #ccc; padding: 4px; text-align: center;"><t t-out="line.end_date and line.end_date.strftime('%d/%m/%Y') or ''"/></td>
                                            </tr>
                                        </t>
                                    </tbody>
                                </table>
                            </div>
                        </t>
                    </div>
                </t>
            </t>
        </t>
    </template>

</odoo>
