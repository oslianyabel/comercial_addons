<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_lineas_por_facturar_multiples_wizard_form" model="ir.ui.view">
        <field name="name">lineas.por.facturar.multiples.wizard.form</field>
        <field name="model">lineas.por.facturar.multiples.wizard</field>
        <field name="arch" type="xml">
            <form string="Facturar Líneas Seleccionadas">
                <group>
                    <group>
                        <field name="contrato_id"/>
                    </group>
                    <group>
                        <field name="departamento_id"/>
                        <field name="total_amount" widget="monetary"/>
                    </group>
                </group>
                <field name="line_ids">
                    <tree string="Líneas a Facturar" editable="0">
                        <field name="name" string="Descripción"/>
                        <field name="product_id" string="Producto"/>
                        <field name="quantity" string="Cantidad"/>
                        <field name="uom_id" string="UOM"/>
                        <field name="price_unit" string="Precio Unit."/>
                        <field name="price_subtotal" string="Subtotal"/>
                        <field name="date_deadline_invoice" string="Límite de Facturación"/>
                    </tree>
                </field>
                <footer>
                    <button name="action_confirm" type="object" string="Facturar" class="btn-primary"/>
                    <button special="cancel" string="Cancelar" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
