<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ================================================================
         VISTA DEDICADA DE "MI EMPRESA" EN res.config.settings
    ================================================================ -->
    <record id="view_config_mi_empresa_form" model="ir.ui.view">
        <field name="name">res.config.settings.mi.empresa.form</field>
        <field name="model">res.config.settings</field>
        <field name="priority">999</field>
        <field name="arch" type="xml">
            <form string="Mi Empresa">
                <sheet>
                    <group>
                        <group string="Empresa">
                            <field name="mi_empresa_partner_id"
                                   options="{'no_create': True}"
                                   string="Mi Empresa"
                                   help="Selecciona el contacto de tipo empresa que representa a tu organizacion. Afecta las listas de Trabajadores y Clientes."/>
                        </group>
                    </group>
                </sheet>
                <footer>
                    <button name="execute" type="object" string="Guardar" class="btn-primary"/>
                    <button special="cancel" string="Descartar"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- ================================================================
         ACCION: MI EMPRESA (settings, sin redireccion)
    ================================================================ -->
    <record id="action_config_mi_empresa" model="ir.actions.act_window">
        <field name="name">Mi Empresa</field>
        <field name="res_model">res.config.settings</field>
        <field name="view_id" ref="view_config_mi_empresa_form"/>
        <field name="view_mode">form</field>
        <field name="target">current</field>
        <field name="context">{'module': 'signature_management', 'bin_size': False}</field>
    </record>

    <!-- ================================================================
         ACCIONES SERVER (dominios dinamicos basados en mi_empresa)
    ================================================================ -->
    <record id="action_server_trabajadores" model="ir.actions.server">
        <field name="name">Trabajadores</field>
        <field name="model_id" ref="base.model_res_company"/>
        <field name="state">code</field>
        <field name="code">action = env['res.company'].action_view_trabajadores()</field>
    </record>

    <record id="action_server_clientes" model="ir.actions.server">
        <field name="name">Clientes</field>
        <field name="model_id" ref="base.model_res_company"/>
        <field name="state">code</field>
        <field name="code">action = env['res.company'].action_view_clientes()</field>
    </record>

    <!-- ================================================================
         VISTA TREE: LINEAS DE FACTURACION
    ================================================================ -->
    <record id="view_lineas_facturacion_tree" model="ir.ui.view">
        <field name="name">contrato.especifico.line.tree.billing</field>
        <field name="model">contrato.especifico.line</field>
        <field name="arch" type="xml">
            <tree string="Líneas de Facturación" create="0" delete="0"
                  default_order="date_deadline_invoice desc">
                <field name="contrato_id" string="Contrato"/>
                <field name="name" string="Descripción"/>
                <field name="product_id" string="Servicio"/>
                <field name="quantity" string="Cantidad"/>
                <field name="uom_id" string="UM"/>
                <field name="price_unit" string="Precio Unitario (CUP)"/>
                <field name="price_subtotal" string="Subtotal (CUP)" sum="Total"/>
                <field name="date_deadline_invoice" string="Límite de Facturación"/>
                <field name="start_date" string="Inicio" optional="show"/>
                <field name="end_date" string="Fin" optional="show"/>
                <field name="invoice_id" string="Factura"/>
                <button name="action_open_invoice" type="object"
                        icon="fa-external-link" title="Ir a la factura"
                        invisible="not invoice_id"/>
                <field name="invoice_state" string="Estado"
                       widget="badge"
                       decoration-info="invoice_state == 'draft'"
                       decoration-success="invoice_state == 'posted'"
                       decoration-danger="invoice_state == 'cancel'"/>
            </tree>
        </field>
    </record>

    <!-- ================================================================
         VISTA SEARCH: LINEAS DE FACTURACION
    ================================================================ -->
    <record id="view_lineas_facturacion_search" model="ir.ui.view">
        <field name="name">contrato.especifico.line.search.billing</field>
        <field name="model">contrato.especifico.line</field>
        <field name="arch" type="xml">
            <search string="Líneas de Facturación">
                <field name="name" string="Descripción"/>
                <field name="contrato_id" string="Contrato"/>
                <field name="product_id" string="Servicio"/>
                <field name="invoice_id" string="Factura"/>
                <filter name="atrasadas" string="Atrasadas"
                        domain="[('is_atrasada', '=', True)]"/>
                <filter name="este_mes" string="Este Mes"
                        domain="[('date_deadline_invoice', '&gt;=', (context_today()).strftime('%Y-%m-01')), ('date_deadline_invoice', '&lt;=', (context_today() + relativedelta(day=31)).strftime('%Y-%m-%d'))]"/>
                <separator/>
                <filter name="estado_borrador" string="Borrador"
                        domain="[('invoice_state', '=', 'draft')]"/>
                <filter name="estado_publicada" string="Publicada"
                        domain="[('invoice_state', '=', 'posted')]"/>
                <filter name="estado_cancelada" string="Cancelada"
                        domain="[('invoice_state', '=', 'cancel')]"/>
                <group expand="0" string="Agrupar Por">
                    <filter name="group_by_contrato" string="Contrato"
                            context="{'group_by': 'contrato_id'}"/>
                    <filter name="group_by_mes" string="Mes Límite"
                            context="{'group_by': 'date_deadline_invoice:month'}"/>
                    <filter name="group_by_estado" string="Estado de Factura"
                            context="{'group_by': 'invoice_state'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- ================================================================
         VISTA TREE: LINEAS POR FACTURAR
    ================================================================ -->
    <record id="view_lineas_por_facturar_tree" model="ir.ui.view">
        <field name="name">contrato.especifico.line.lineas.por.facturar.tree</field>
        <field name="model">contrato.especifico.line</field>
        <field name="arch" type="xml">
            <tree string="Líneas por Facturar"
                  default_order="date_deadline_invoice asc"
                  decoration-danger="is_deadline_past"
                  decoration-warning="is_deadline_soon"
                  create="0" delete="0">
                <field name="is_deadline_past" column_invisible="1"/>
                <field name="is_deadline_soon" column_invisible="1"/>
                <field name="invoiced" column_invisible="1"/>
                <field name="contrato_id" string="Contrato Específico"/>
                <button name="action_open_contrato" type="object" string="" icon="fa-external-link"
                        title="Ver Contrato Específico"
                        invisible="not contrato_id"/>
                <field name="contrato_state" string="Estado" widget="badge"
                       decoration-success="contrato_state == 'firmado'"
                       decoration-warning="contrato_state == 'entregado'"
                       decoration-danger="contrato_state == 'cancelado'"
                       decoration-muted="contrato_state == 'borrador'"/>
                <field name="name" string="Descripción"/>
                <field name="product_id" string="Producto"/>
                <field name="quantity" string="Cantidad"/>
                <field name="uom_id" string="UOM"/>
                <field name="price_unit" string="Precio Unit."/>
                <field name="price_subtotal" string="Subtotal" widget="monetary"/>
                <field name="date_deadline_invoice" string="Límite de Facturación"/>
                <button name="action_facturar" string="Facturar" type="object"
                        icon="fa-money" class="btn-sm btn-primary"
                        invisible="invoiced"/>
            </tree>
        </field>
    </record>

    <!-- ================================================================
         VISTA SEARCH: LINEAS POR FACTURAR
    ================================================================ -->
    <record id="view_lineas_por_facturar_search" model="ir.ui.view">
        <field name="name">contrato.especifico.line.lineas.por.facturar.search</field>
        <field name="model">contrato.especifico.line</field>
        <field name="arch" type="xml">
            <search string="Buscar Líneas por Facturar">
                <field name="name" string="Descripción"/>
                <field name="contrato_id" string="Contrato"/>
                <field name="product_id" string="Producto"/>
                <separator/>
                <filter name="solo_firmados" string="Contratos Firmados"
                        domain="[('contrato_id.state', '=', 'firmado')]"/>
                <separator/>
                <filter name="vencidas" string="Vencidas"
                        domain="[('date_deadline_invoice', '&lt;', context_today().strftime('%Y-%m-%d'))]"/>
                <filter name="proximas" string="Vencen en 7 días"
                        domain="[('date_deadline_invoice', '&gt;=', context_today().strftime('%Y-%m-%d')), ('date_deadline_invoice', '&lt;=', (context_today() + relativedelta(days=7)).strftime('%Y-%m-%d'))]"/>
                <separator/>
                <filter name="mes_actual" string="Mes Actual"
                        domain="[('date_deadline_invoice', '&gt;=', (context_today()).strftime('%Y-%m-01')), ('date_deadline_invoice', '&lt;=', (context_today() + relativedelta(day=31)).strftime('%Y-%m-%d'))]"/>
                <filter name="filter_by_deadline_month" string="Por Mes Límite"
                        date="date_deadline_invoice"/>
                <group expand="0" string="Agrupar por">
                    <filter name="group_by_contrato" string="Contrato"
                            context="{'group_by': 'contrato_id'}"/>
                    <filter name="group_by_mes" string="Mes Límite"
                            context="{'group_by': 'date_deadline_invoice:month'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- ================================================================
         SERVER ACTION: FACTURAR SELECCIONADAS (bulk desde lista)
    ================================================================ -->
    <record id="action_server_facturar_seleccionadas" model="ir.actions.server">
        <field name="name">Facturar Seleccionadas</field>
        <field name="model_id" ref="contratos_especificos.model_contrato_especifico_line"/>
        <field name="binding_model_id" ref="contratos_especificos.model_contrato_especifico_line"/>
        <field name="binding_view_types">list</field>
        <field name="state">code</field>
        <field name="code">action = records.action_facturar_multiples_wizard()</field>
    </record>

    <!-- ================================================================
         ACCION: LINEAS POR FACTURAR
    ================================================================ -->
    <record id="action_lineas_por_facturar" model="ir.actions.act_window">
        <field name="name">Líneas por Facturar</field>
        <field name="res_model">contrato.especifico.line</field>
        <field name="view_mode">tree,form</field>
        <field name="domain">[('invoiced', '=', False), ('is_invoice_line', '=', False)]</field>
        <field name="context">{'search_default_mes_actual': 1}</field>
        <field name="view_ids" eval="[(5, 0, 0), (0, 0, {'view_mode': 'tree', 'view_id': ref('signature_management.view_lineas_por_facturar_tree')})]"/>
        <field name="search_view_id" ref="view_lineas_por_facturar_search"/>
    </record>

    <!-- ================================================================
         ACCION: LINEAS DE FACTURACION (mes actual y atrasadas)
    ================================================================ -->
    <record id="action_lineas_facturacion" model="ir.actions.act_window">
        <field name="name">Líneas de Facturas</field>
        <field name="res_model">contrato.especifico.line</field>
        <field name="view_mode">tree,form</field>
        <field name="domain">[('invoiced', '=', False), ('date_deadline_invoice', '&lt;=', (context_today() + relativedelta(day=31)).strftime('%Y-%m-%d'))]</field>
        <field name="view_ids" eval="[(5, 0, 0), (0, 0, {'view_mode': 'tree', 'view_id': ref('signature_management.view_lineas_facturacion_tree')})]"/>
        <field name="search_view_id" ref="view_lineas_facturacion_search"/>
    </record>

    <!-- ================================================================
         ACCION: FACTURAS DE CONTRATOS ESPECIFICOS
    ================================================================ -->
    <record id="action_facturas_contratos" model="ir.actions.act_window">
        <field name="name">Facturas</field>
        <field name="res_model">account.move</field>
        <field name="view_mode">tree,form</field>
        <field name="domain">[('contrato_especifico_id', '!=', False), ('move_type', '=', 'out_invoice')]</field>
        <field name="context">{'default_move_type': 'out_invoice'}</field>
        <field name="view_ids" eval="[(5, 0, 0), (0, 0, {'view_mode': 'tree', 'view_id': ref('signature_management.view_move_tree_contract_restricted')})]"/>
    </record>

    <!-- ================================================================
         ACCIONES CONFIG (replicas de ajustes para el navbar)
    ================================================================ -->
    <record id="action_config_tiempos_validez" model="ir.actions.act_window">
        <field name="name">Tiempos de Validez</field>
        <field name="res_model">res.config.settings</field>
        <field name="view_mode">form</field>
        <field name="target">current</field>
        <field name="context">{'module': 'contratos', 'bin_size': False}</field>
    </record>

    <record id="action_config_firmas" model="ir.actions.act_window">
        <field name="name">Firmas</field>
        <field name="res_model">res.config.settings</field>
        <field name="view_mode">form</field>
        <field name="target">current</field>
        <field name="context">{'module': 'signature_management', 'bin_size': False}</field>
    </record>

    <!-- ================================================================
         MENU: FACTURAS (grupo padre)
    ================================================================ -->
    <menuitem id="menu_facturas_group"
              name="Facturas"
              parent="contratos.menu_contrato_root"
              sequence="40"/>

    <menuitem id="menu_facturas_contratos"
              name="Facturas"
              parent="menu_facturas_group"
              action="action_facturas_contratos"
              sequence="10"/>

    <menuitem id="menu_lineas_facturacion"
              name="Líneas de Facturas"
              parent="menu_facturas_group"
              action="action_lineas_facturacion"
              sequence="20"/>

    <menuitem id="menu_lineas_por_facturar"
              name="Líneas por Facturar"
              parent="menu_facturas_group"
              action="action_lineas_por_facturar"
              sequence="15"/>

    <!-- ================================================================
         MENU: CLIENTES
    ================================================================ -->
    <menuitem id="menu_clientes_group"
              name="Clientes"
              parent="contratos.menu_contrato_root"
              action="action_server_clientes"
              sequence="50"/>

    <!-- ================================================================
         MENU: TRABAJADORES
    ================================================================ -->
    <menuitem id="menu_trabajadores_group"
              name="Trabajadores"
              parent="contratos.menu_contrato_root"
              action="action_server_trabajadores"
              sequence="55"/>

    <!-- ================================================================
         MENU: CONFIGURACION (solo admins)
    ================================================================ -->
    <menuitem id="menu_configuracion_group"
              name="Configuracion"
              parent="contratos.menu_contrato_root"
              sequence="60"
              groups="base.group_system"/>

    <menuitem id="menu_empresa"
              name="Empresas"
              parent="menu_configuracion_group"
              action="contratos.action_contratos_empresa"
              sequence="20"/>

    <menuitem id="menu_config_mi_empresa"
              name="Mi Empresa"
              parent="menu_configuracion_group"
              action="action_config_mi_empresa"
              sequence="10"/>

    <menuitem id="menu_config_tiempos_validez"
              name="Tiempos de Validez"
              parent="menu_configuracion_group"
              action="action_config_tiempos_validez"
              sequence="30"/>

    <menuitem id="menu_config_firmas"
              name="Configuración de Firmas"
              parent="menu_configuracion_group"
              action="action_config_firmas"
              sequence="40"/>

    <menuitem id="menu_config_firmas_y_cunos"
              name="Firmas y Cuños"
              parent="menu_configuracion_group"
              action="action_res_signature"
              sequence="41"/>

    <menuitem id="menu_config_departamentos"
              name="Departamentos"
              parent="menu_configuracion_group"
              action="partner_custom_fields.action_res_partner_departamento"
              sequence="25"/>
</odoo>