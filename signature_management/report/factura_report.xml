<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Override the standard invoice print action to use our custom template -->
    <record id="account.account_invoices" model="ir.actions.report">
        <field name="report_name">signature_management.report_factura_template</field>
        <field name="report_file">signature_management.report_factura_template</field>
    </record>

    <!-- ═══════════════════════════════════════════════════════
         TEMPLATE: Factura de Contrato
    ═══════════════════════════════════════════════════════ -->
    <template id="report_factura_template">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-set="company" t-value="o.company_id"/>
                <style>
                    .factura-personalizada, .factura-personalizada * {
                        letter-spacing: 0.4px !important;
                        word-spacing: 0.4px !important;
                    }
                    .factura-personalizada span {
                        letter-spacing: 0.4px !important;
                        display: inline-block !important;
                    }
                    .factura-personalizada table, .factura-personalizada td, .factura-personalizada th {
                        border: 0 none !important;
                        border-width: 0 !important;
                        border-style: none !important;
                    }
                </style>
                <div class="article factura-personalizada" style="font-family: 'DejaVu Sans', Arial, sans-serif; font-size: 12px; padding: 10mm 15mm; letter-spacing: 0.4px; word-spacing: 0.5px;">

                    <!-- TOP HEADER -->
                    <table border="0" cellspacing="0" cellpadding="0" style="width:100%; border-collapse:collapse; margin-bottom:8px;">
                        <tr>
                            <td style="width:55%; vertical-align:top; padding-right:10px; border:0;">
                                <table border="0" cellspacing="0" cellpadding="0" style="width:100%; border-collapse:collapse;">
                                    <tr>
                                        <td style="width:80px; vertical-align:top; padding-right:8px; border:0;">
                                            <t t-if="company.logo">
                                                <img t-att-src="image_data_uri(company.logo)"
                                                     style="max-width:80px; max-height:60px; width:auto; height:auto;"/>
                                            </t>
                                        </td>
                                        <td style="vertical-align:top; font-size:10px; border:0;">
                                            <t t-if="o.organismo_id">
                                                <div><strong>Organismo:</strong> <span style="letter-spacing: 0.4px; white-space: nowrap;"><t t-out="o._report_spaced_text(o.organismo_id.name)"/></span></div>
                                            </t>
                                            <t t-if="o.empresa_id">
                                                <div><strong>Empresa:</strong> <span style="letter-spacing: 0.4px; white-space: nowrap;"><t t-out="o._report_spaced_text(o.empresa_id.name or '')"/></span></div>
                                            </t>
                                            <t t-if="o.unidad_empresa">
                                                <div><strong>Unidad:</strong> <span style="letter-spacing: 0.4px; white-space: nowrap;"><t t-out="o._report_spaced_text(o.unidad_empresa)"/></span></div>
                                            </t>
                                            <t t-if="o.direccion_empresa">
                                                <div><strong>Dirección:</strong> <span style="letter-spacing: 0.4px; white-space: nowrap;"><t t-out="o._report_spaced_text(o.direccion_empresa)"/></span></div>
                                            </t>
                                        </td>
                                    </tr>
                                </table>
                            </td>
                            <td style="width:45%; vertical-align:top; text-align:right; padding-left:10px; border:0;">
                                <div style="font-size:10px;">
                                    <strong>Fecha de emisión:</strong>
                                    <t t-if="o.invoice_date">
                                        <span style="letter-spacing: 0.4px; white-space: nowrap;"><t t-out="o._report_spaced_text(o.invoice_date.strftime('%d/%m/%Y'))"/></span>
                                    </t>
                                </div>
                                <div style="font-size:10px; margin-bottom:4px;">
                                    <strong>Página</strong> <span class="page"/> de <span class="topage"/>
                                </div>
                                <div style="font-size:22px; font-weight:bold; letter-spacing: 0.4px; margin:4px 0;">
                                    FACTURA
                                </div>
                                <div style="font-size:10px;">
                                    <strong>Número:</strong> <span style="letter-spacing: 0.4px; white-space: nowrap;"><t t-out="o._report_spaced_text(o.name or '')"/></span>
                                </div>
                                <div style="font-size:10px;">
                                    <strong>NIT:</strong> <span style="letter-spacing: 0.4px; white-space: nowrap;"><t t-out="o._report_spaced_text(o.nit_empresa or '')"/></span>
                                    <t t-if="o.contrato_especifico_id">
                                        &#160;&#160;<strong>Contrato:</strong> <span style="letter-spacing: 0.4px; white-space: nowrap;"><t t-out="o._report_spaced_text(o.contrato_especifico_id.name)"/></span>
                                    </t>
                                </div>
                            </td>
                        </tr>
                    </table>

                    <div style="margin:6px 0;"/>

                    <!-- CENTRAL -->
                    <div style="text-align:center; font-size:16px; font-weight:bold; margin:6px 0; letter-spacing: 0.4px;">
                        Ventas en CUP
                    </div>

                    <table border="0" cellspacing="0" cellpadding="0" style="width:100%; font-size:10px; margin-bottom:4px; letter-spacing: 0.4px;">
                        <tr>
                            <td style="width:50%; border:0;"><strong>Código:</strong> <span style="letter-spacing: 0.4px; white-space: nowrap;"><t t-out="o._report_spaced_text(o.codigo_cliente or '')"/></span></td>
                            <td style="width:50%; border:0;"><strong>Cliente:</strong>
                                <span style="letter-spacing: 0.4px; white-space: nowrap;"><t t-out="o._report_spaced_text(o.cliente_id.name if o.cliente_id else (o.partner_id.name or ''))"/></span>
                            </td>
                        </tr>
                        <tr>
                            <td colspan="2" style="border:0;"><strong>Dirección:</strong> <span style="letter-spacing: 0.4px; white-space: nowrap;"><t t-out="o._report_spaced_text(o.direccion_cliente or '')"/></span></td>
                        </tr>
                        <tr>
                            <td style="border:0;"><strong>NIT:</strong> <span style="letter-spacing: 0.4px; white-space: nowrap;"><t t-out="o._report_spaced_text(o.nit_cliente or o.client_nit or '')"/></span></td>
                            <td style="border:0;">
                                <strong>Número Ins. RCC:</strong> <span style="letter-spacing: 0.4px; white-space: nowrap;"><t t-out="o._report_spaced_text(o.num_ins_rcc or '')"/></span>
                                &#160;&#160;
                                <strong>Cuenta Bancaria:</strong> <span style="letter-spacing: 0.4px; white-space: nowrap;"><t t-out="o._report_spaced_text(o.cuenta_bancaria_cliente or o.client_bank_account or '')"/></span>
                            </td>
                        </tr>
                        <tr>
                            <td style="border:0;">
                                <strong>Forma de pago:</strong>
                                <span style="letter-spacing: 0.4px; white-space: nowrap;"><t t-out="o._report_spaced_text(o.invoice_payment_term_id.name if o.invoice_payment_term_id else '')"/></span>
                            </td>
                            <td style="border:0;">
                                <strong>Operación:</strong>
                                <span style="letter-spacing: 0.4px; white-space: nowrap;"><t t-out="o._report_spaced_text(o.operacion_label or '')"/></span>
                            </td>
                        </tr>
                    </table>

                    <!-- Service lines -->
                    <table border="0" cellspacing="0" cellpadding="0" style="width:100%; font-size:10px; margin-top:6px; letter-spacing: 0.4px;">
                        <thead>
                            <tr>
                                <th style="padding:3px 5px; text-align:center; border:0;">Código</th>
                                <th style="padding:3px 5px; text-align:left; border:0;">Descripción</th>
                                <th style="padding:3px 5px; text-align:center; border:0;">UM</th>
                                <th style="padding:3px 5px; text-align:center; border:0;">Cantidad</th>
                                <th style="padding:3px 5px; text-align:right; border:0;">Precio</th>
                                <th style="padding:3px 5px; text-align:right; border:0;">Importe</th>
                            </tr>
                        </thead>
                        <tbody>
                            <t t-foreach="o.invoice_line_ids.filtered(lambda l: l.display_type == 'product')" t-as="line">
                                <tr>
                                    <td style="padding:3px 5px; text-align:center; border:0;">
                                        <span style="letter-spacing: 0.4px; white-space: nowrap;"><t t-out="o._report_spaced_text(line.product_id.default_code or '')"/></span>
                                    </td>
                                    <td style="padding:3px 5px; border:0;">
                                        <span style="letter-spacing: 0.4px;"><t t-out="o._report_spaced_text(line.name or '')"/></span>
                                    </td>
                                    <td style="padding:3px 5px; text-align:center; border:0;">
                                        <span style="letter-spacing: 0.4px; white-space: nowrap;"><t t-out="o._report_spaced_text(line.product_uom_id.name if line.product_uom_id else '')"/></span>
                                    </td>
                                    <td style="padding:3px 5px; text-align:center; border:0;">
                                        <span style="letter-spacing: 0.4px; white-space: nowrap;"><t t-out="o._report_spaced_text('%.2f' % line.quantity)"/></span>
                                    </td>
                                    <td style="padding:3px 5px; text-align:right; border:0;">
                                        <span style="letter-spacing: 0.4px; white-space: nowrap;"><t t-out="o._report_spaced_text('%.2f' % line.price_unit)"/></span>
                                    </td>
                                    <td style="padding:3px 5px; text-align:right; border:0;">
                                        <span style="letter-spacing: 0.4px; white-space: nowrap;"><t t-out="o._report_spaced_text('%.2f' % line.price_subtotal)"/></span>
                                    </td>
                                </tr>
                            </t>
                        </tbody>
                        <tfoot>
                            <tr>
                                <td colspan="5" style="padding:3px 5px; text-align:right; font-weight:bold; border:0;">
                                    Subtotal servicios:
                                </td>
                                <td style="padding:3px 5px; text-align:right; font-weight:bold; border:0;">
                                    <span style="letter-spacing: 0.4px; white-space: nowrap;"><t t-out="o._report_spaced_text('%.2f' % sum(o.invoice_line_ids.filtered(lambda l: l.display_type == 'product').mapped('price_subtotal')))"/></span>
                                </td>
                            </tr>
                        </tfoot>
                    </table>

                    <div style="margin-top:48px; font-size:11px;">
                        <span style="letter-spacing: 0.4px; word-spacing: 0.4px; display:inline-block;"><t t-out="o._report_spaced_label('Total en CUP:')"/></span> <span style="letter-spacing: 0.4px; display:inline-block;"><t t-out="o._report_spaced_text(o.total_cup_literal or ('%.2f' % o.amount_total))"/></span>
                    </div>

                    <div style="margin-top:4px; font-size:11px; padding:4px 0;">
                        <span style="letter-spacing: 0.4px; word-spacing: 0.4px; display:inline-block;"><t t-out="o._report_spaced_label('Páguese CUP a')"/></span> <span style="letter-spacing: 0.4px; white-space: nowrap; display:inline-block;"><t t-out="o._report_spaced_text(o.empresa_id.name or '')"/></span>
                        <span style="letter-spacing: 0.4px; word-spacing: 0.4px; display:inline-block;"><t t-out="o._report_spaced_label('Cuenta')"/></span> <span style="letter-spacing: 0.4px; white-space: nowrap; display:inline-block;"><t t-out="o._report_spaced_text(o.cuenta_pagar or '')"/></span>
                        <span style="letter-spacing: 0.4px; word-spacing: 0.4px; display:inline-block;"><t t-out="o._report_spaced_label('Sucursal')"/></span> <span style="letter-spacing: 0.4px; white-space: nowrap; display:inline-block;"><t t-out="o._report_spaced_text(o.sucursal_pagar or '')"/></span>
                        <span style="letter-spacing: 0.4px; word-spacing: 0.4px; display:inline-block;"><t t-out="o._report_spaced_label('del')"/></span> <span style="letter-spacing: 0.4px; white-space: nowrap; display:inline-block;"><t t-out="o._report_spaced_text(o.banco_pagar.name if o.banco_pagar else '')"/></span>
                    </div>

                    <t t-if="o.total_cup_literal">
                        <div style="margin-top:4px; font-size:10px; font-style:italic; letter-spacing: 0.4px;">
                            <span style="letter-spacing: 0.4px;"><t t-out="o._report_spaced_text(o.total_cup_literal)"/></span>
                        </div>
                    </t>

                    <div style="margin:10px 0;"/>

                    <!-- FIRMAS: sin bordes de tabla, columnas con div inline-block -->
                    <div style="font-size:9px; margin-top:4px; letter-spacing: 0.4px;">
                        <table border="0" cellspacing="0" cellpadding="0" style="width:100%; font-size:9px;">
                            <tr style="vertical-align:top;">
                                <td style="width:20%; padding:4px 6px 4px 0; vertical-align:top; border:0; letter-spacing: 0.4px;">
                                    <div style="font-weight:bold; margin-bottom:6px;">Realizada por</div>
                                    <div><strong>Nombre:</strong> <span style="border-bottom:1px solid #333; display:inline-block; min-width:60px; padding-bottom:1px; letter-spacing: 0.4px; white-space: nowrap;"><t t-out="o._report_spaced_text(o.realizada_por_id.name if o.realizada_por_id else '')"/></span></div>
                                    <div><strong>Cargo:</strong> <span style="border-bottom:1px solid #333; display:inline-block; min-width:60px; padding-bottom:1px; letter-spacing: 0.4px; white-space: nowrap;"><t t-out="o._report_spaced_text(o.realizada_por_id.function if o.realizada_por_id else '')"/></span></div>
                                    <div style="margin-top:16px;"><strong>Firma</strong> <span style="display:inline-block; border-bottom:1px solid #333; width:50px; vertical-align:bottom; margin-left:4px;"></span></div>
                                    <div style="margin-top:4px;"><strong>Fecha:</strong> <span style="border-bottom:1px solid #333; display:inline-block; min-width:50px; padding-bottom:1px; letter-spacing: 0.4px; white-space: nowrap;"><t t-if="o.realizada_fecha"><t t-out="o._report_spaced_text(o.realizada_fecha.strftime('%d/%m/%Y'))"/></t></span></div>
                                </td>
                                <td style="width:25%; padding:4px 6px 4px 6px; vertical-align:top; border:0; letter-spacing: 0.4px;">
                                    <div style="font-weight:bold; margin-bottom:6px;">Transportado por</div>
                                    <div><strong>Nombre:</strong> <span style="border-bottom:1px solid #333; display:inline-block; min-width:60px; padding-bottom:1px; letter-spacing: 0.4px; white-space: nowrap;"><t t-out="o._report_spaced_text(o.transportado_por_id.name if o.transportado_por_id else '')"/></span></div>
                                    <div>
                                        <strong>CH:</strong> <span style="border-bottom:1px solid #333; display:inline-block; min-width:22px; padding-bottom:1px; letter-spacing: 0.4px; white-space: nowrap;"><t t-out="o._report_spaced_text(o.transportado_ch)"/></span>
                                        &#160;<strong>LIC:</strong> <span style="border-bottom:1px solid #333; display:inline-block; min-width:22px; padding-bottom:1px; letter-spacing: 0.4px; white-space: nowrap;"><t t-out="o._report_spaced_text(o.transportado_lic)"/></span>
                                        &#160;<strong>CI:</strong> <span style="border-bottom:1px solid #333; display:inline-block; min-width:22px; padding-bottom:1px; letter-spacing: 0.4px; white-space: nowrap;"><t t-out="o._report_spaced_text(o.transportado_por_id.id_card if o.transportado_por_id else '')"/></span>
                                    </div>
                                    <div style="margin-top:16px;"><strong>Firma</strong> <span style="display:inline-block; border-bottom:1px solid #333; width:50px; vertical-align:bottom; margin-left:4px;"></span></div>
                                    <div style="margin-top:4px;"><strong>Fecha:</strong> <span style="border-bottom:1px solid #333; display:inline-block; min-width:50px; padding-bottom:1px; letter-spacing: 0.4px; white-space: nowrap;"><t t-if="o.transportado_fecha"><t t-out="o._report_spaced_text(o.transportado_fecha.strftime('%d/%m/%Y'))"/></t></span></div>
                                </td>
                                <td style="width:20%; padding:4px 6px 4px 6px; vertical-align:top; border:0; letter-spacing: 0.4px;">
                                    <div style="font-weight:bold; margin-bottom:6px;">Recibido por</div>
                                    <div><strong>Nombre:</strong> <span style="border-bottom:1px solid #333; display:inline-block; min-width:60px; padding-bottom:1px; letter-spacing: 0.4px; white-space: nowrap;"><t t-out="o._report_spaced_text(o.recibido_por_id.name if o.recibido_por_id else '')"/></span></div>
                                    <div><strong>Cargo:</strong> <span style="border-bottom:1px solid #333; display:inline-block; min-width:60px; padding-bottom:1px; letter-spacing: 0.4px; white-space: nowrap;"><t t-out="o._report_spaced_text(o.recibido_por_id.function if o.recibido_por_id else '')"/></span></div>
                                    <div><strong>CI:</strong> <span style="border-bottom:1px solid #333; display:inline-block; min-width:50px; padding-bottom:1px; letter-spacing: 0.4px; white-space: nowrap;"><t t-out="o._report_spaced_text(o.recibido_por_id.id_card if o.recibido_por_id else '')"/></span></div>
                                    <div style="margin-top:16px;"><strong>Firma</strong> <span style="display:inline-block; border-bottom:1px solid #333; width:50px; vertical-align:bottom; margin-left:4px;"></span></div>
                                    <div style="margin-top:4px;"><strong>Fecha:</strong> <span style="border-bottom:1px solid #333; display:inline-block; min-width:50px; padding-bottom:1px; letter-spacing: 0.4px; white-space: nowrap;"><t t-if="o.recibido_fecha"><t t-out="o._report_spaced_text(o.recibido_fecha.strftime('%d/%m/%Y'))"/></t></span></div>
                                </td>
                                <td style="width:20%; padding:4px 6px 4px 6px; vertical-align:top; border:0; letter-spacing: 0.4px;">
                                    <div style="font-weight:bold; margin-bottom:6px;">Entregada por</div>
                                    <div><strong>Nombre:</strong> <span style="border-bottom:1px solid #333; display:inline-block; min-width:60px; padding-bottom:1px; letter-spacing: 0.4px; white-space: nowrap;"><t t-out="o._report_spaced_text(o.entregada_por_id.name if o.entregada_por_id else '')"/></span></div>
                                    <div style="margin-top:16px;"><strong>Firma</strong> <span style="display:inline-block; border-bottom:1px solid #333; width:50px; vertical-align:bottom; margin-left:4px;"></span></div>
                                    <div style="margin-top:4px;"><strong>Fecha:</strong> <span style="border-bottom:1px solid #333; display:inline-block; min-width:50px; padding-bottom:1px; letter-spacing: 0.4px; white-space: nowrap;"><t t-if="o.entregada_fecha"><t t-out="o._report_spaced_text(o.entregada_fecha.strftime('%d/%m/%Y'))"/></t></span></div>
                                </td>
                            </tr>
                        </table>

                        <!-- Contabilizada por -->
                        <div style="margin-top:8px; width:30%; letter-spacing: 0.4px;">
                            <div style="font-weight:bold; margin-bottom:6px;">Contabilizada por</div>
                            <div><strong>Nombre:</strong> <span style="border-bottom:1px solid #333; display:inline-block; min-width:80px; padding-bottom:1px; letter-spacing: 0.4px; white-space: nowrap;"><t t-out="o._report_spaced_text(o.contabilizada_por_id.name if o.contabilizada_por_id else '')"/></span></div>
                            <div style="margin-top:16px;"><strong>Firma</strong> <span style="display:inline-block; border-bottom:1px solid #333; width:50px; vertical-align:bottom; margin-left:4px;"></span></div>
                            <div style="margin-top:4px;"><strong>Fecha:</strong> <span style="border-bottom:1px solid #333; display:inline-block; min-width:50px; padding-bottom:1px; letter-spacing: 0.4px; white-space: nowrap;"><t t-if="o.contabilizada_fecha"><t t-out="o._report_spaced_text(o.contabilizada_fecha.strftime('%d/%m/%Y'))"/></t></span></div>
                        </div>
                    </div>

                    <!-- Cuño: al fondo del reporte, sin tabla -->
                    <t t-if="o.cunyo_id and o.cunyo_id.image">
                        <div style="margin-top:16px; text-align:left;">
                            <img t-att-src="image_data_uri(o.cunyo_id.image)"
                                 style="max-width:110px; max-height:110px; width:auto; height:auto;"/>
                        </div>
                    </t>

                </div>
            </t>
        </t>
    </template>

</odoo>
